{
	"name": "example-frontend-vue",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "./dms.frontend.ts",
	"packageManager": "pnpm@10.34.9",
	"engines": {
		"@antelopejs/dms-frontend": ">=0.11.12 <0.12.0"
	},
	"scripts": {
		"dev": "pnpm --dir .. frontend:dev",
		"build": "pnpm --dir .. frontend:build",
		"format": "prettier --write .",
		"lint": "eslint . && prettier --check . && node --input-type=module -e \"import { assertDmsComponents } from '@antelopejs/dms/checks/dms-components'; await assertDmsComponents({ layer: '.', sources: ['../src'] });\"",
		"test": "vitest run"
	},
	"dependencies": {
		"vue": "^3.5.45"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^6.0.11",
		"eslint": "^9.39.5",
		"eslint-plugin-vue": "^10.12.1",
		"jsdom": "^26.1.0",
		"prettier": "^3.10.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^3.2.7"
	}
}
